{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; test -n \"$d\" || exit 0; s=\"$d/scripts/run_codex_bead_hooks.sh\"; test -f \"$s\" || exit 0; exec bash \"$s\" UserPromptSubmit",
            "statusMessage": "Refreshing Beads context and workflow status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; test -n \"$d\" || exit 0; s=\"$d/scripts/run_codex_bead_hooks.sh\"; test -f \"$s\" || exit 0; exec bash \"$s\" Stop",
            "statusMessage": "Resolving pending bead labels",
            "type": "command"
          }
        ]
      }
    ]
  }
}
