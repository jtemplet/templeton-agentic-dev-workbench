#!/usr/bin/env sh
# beads shim. tadw's own checks live in .githooks/pre-push; this hook is beads only.
#
# pre-push deliberately does NOT call `bd hooks run`: it exports the tracker and
# commits .beads/ itself, for the reasons recorded at the end of that file. Do not
# 'fix' it by adding a beads section there, which would export twice.
# --- BEGIN BEADS EXPORT ---
# Fold .beads/issues.jsonl into the commit being made, so it is never left dirty
# for someone to notice later. Ported from atlas (atlas-xh3s).
#
# Deliberately contains no `exit`: this runs inside a hook whose own status
# decides the commit, and an `exit 0` here would turn a failing gate into a
# passing one. Every failure path below leaves the status alone.
#
# Two guards, both load-bearing:
#   - A timeout, because bd can block on database lock contention and a stuck bd
#     would otherwise hang the commit with nothing on screen. Shorter than bd's
#     own 300s: a commit should not stall for minutes over an export.
#   - A temp file, because `bd export -o` truncates its target as it starts, so
#     a killed export would leave a partial file, and staging that is worse than
#     not exporting at all.
if command -v bd >/dev/null 2>&1; then
  _bx_tmp=".beads/.issues.jsonl.hook-tmp"
  _bx_timeout="${BEADS_HOOK_TIMEOUT:-30}"
  if command -v timeout >/dev/null 2>&1; then _bx_run="timeout $_bx_timeout"
  elif command -v gtimeout >/dev/null 2>&1; then _bx_run="gtimeout $_bx_timeout"
  else _bx_run=""; fi
  if $_bx_run bd export -o "$_bx_tmp" >/dev/null 2>&1 && [ -s "$_bx_tmp" ]; then
    mv -f "$_bx_tmp" .beads/issues.jsonl
    if ! git diff --quiet HEAD -- .beads/issues.jsonl 2>/dev/null; then
      git add -- .beads/issues.jsonl
      echo "pre-commit: refreshed .beads/issues.jsonl into this commit"
    fi
  else
    rm -f "$_bx_tmp"
  fi
fi
# --- END BEADS EXPORT ---

# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---
