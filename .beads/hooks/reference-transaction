#!/usr/bin/env sh
# Insurance shim. Not the gate: the real reference-transaction lives in .githooks/reference-transaction.
#
# core.hooksPath should be .githooks in this repository, and while it is, this
# file never runs. It exists because `bd init` sets core.hooksPath to
# .beads/hooks on its own (measured 2026-09-07), so anything that re-initializes
# bd silently repoints git here.
#
# This one was identical to its counterpart when the other four were shimmed,
# so it was left as a copy. That was the wrong call: identical today is what
# every one of the others was before it drifted, and this hook is the gate on
# `v*` tags and `claude plugin validate`. Deferring is what stops the drift,
# not being in sync at one moment.
#
# exec, so stdin reaches the real hook. reference-transaction is handed the ref
# updates on stdin and can abort a transaction by exiting non-zero, so both the
# input and the status have to pass through untouched.
_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
_real="$_root/.githooks/reference-transaction"
[ -x "$_real" ] || exit 0
exec "$_real" "$@"
