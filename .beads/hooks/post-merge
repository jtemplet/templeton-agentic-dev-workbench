#!/usr/bin/env sh
# Insurance shim. Not the gate: the real post-merge lives in .githooks/post-merge.
#
# core.hooksPath should be .githooks in this repository, and while it is, this
# file never runs. It exists because `bd init` sets core.hooksPath to
# .beads/hooks on its own (measured 2026-09-07), so anything that re-initializes
# bd silently repoints git here. Before this shim that meant the 341-line
# pre-push gate stopped running and nothing said so, which is the exact class of
# silent gap .githooks/pre-push was written to close.
#
# Deferring rather than duplicating: a copy would drift, and it did. All five
# hooks here had diverged from their .githooks counterpart, pre-push by 149
# lines.
#
# exec, so stdin reaches the real hook. pre-push reads the refs being pushed
# from stdin, and a shim that swallowed it would break that hook quietly.
_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
_real="$_root/.githooks/post-merge"
[ -x "$_real" ] || exit 0
exec "$_real" "$@"
