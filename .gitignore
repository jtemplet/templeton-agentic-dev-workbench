.outrigger/lock.d/
.outrigger/pick.lock/
.outrigger/stop
.outrigger/*.log
.outrigger/logs/
.outrigger/worktrees/

# Local settings (user-specific)
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
*.swp
*.swo
*~

# Node modules (if any tooling added)
node_modules/

# Python bytecode cache (from skill scripts)
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# Beads (bd) - runtime artifacts handled by .beads/.gitignore
# Only need to ignore files not covered there
.beads/daemon.log
.beads/.local_version

# Beads Viewer (bv) - track workspace config, ignore cache
.bv/*
!.bv/workspace.yml

# Claude Code session lease files (one per live process holding this dir)
.in_use/

# Backup skills
skills/rails-conventions-BAK/

# Agent tool worktree isolation (ephemeral, local-only)
.worktrees/

# Eval run artifacts (real model output; regenerate with evals/run.py)
evals/results/
evals/results-*.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
