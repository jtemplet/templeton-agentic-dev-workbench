{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.md) rumdl fmt \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "Running rumdl fmt...",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/close_bead_on_pr_merge.sh\"",
            "statusMessage": "Checking for bead to close...",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/label_bead_on_skill_invocation.sh\"",
            "statusMessage": "simplify / code-review / fresh-eyes-cr / quality-gates / verify-acceptance: labeling bead...",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/label_bead_on_skill_invocation.sh\"",
            "statusMessage": "Resolving pending bead labels...",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/label_bead_on_skill_invocation.sh\"",
            "statusMessage": "slash command: labeling bead..."
          }
        ]
      }
    ]
  }
}
